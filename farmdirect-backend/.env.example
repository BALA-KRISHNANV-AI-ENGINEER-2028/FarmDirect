# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database ---
# Full connection string for the Postgres instance (must have PostGIS available to enable).
DATABASE_URL=postgres://farmdirect:farmdirect@localhost:5432/farmdirect_dev
# Set to "true" only if your DB provider requires SSL (most managed cloud Postgres does).
DATABASE_SSL=false

# --- Auth ---
# Use long, random, unique values in every environment. Never reuse across environments.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
BCRYPT_COST=12

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173

# --- Cookies ---
# Set to "true" in production (requires HTTPS).
COOKIE_SECURE=false
